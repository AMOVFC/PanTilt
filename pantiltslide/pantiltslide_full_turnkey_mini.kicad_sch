	(text "DECOUPLING  -  every cap carries a `Decouples` field naming the pin it belongs beside"
		(exclude_from_sim no)
		(at 40.64 330.2 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5d476e21-ff23-5315-b97c-187d32fb0d61")
	)
	(text "Every I2C device here is a plug-in module, so these are belt-and-braces:"
		(exclude_from_sim no)
		(at 172.72 391.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9607f2a4-9c64-57f4-bb78-82067a96c0f9")
	)
	(text "lift one if a module turns out to carry a strong pull-up of its own."
		(exclude_from_sim no)
		(at 172.72 394.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "974cf1ea-8a18-5f9c-be0d-9c1b24ae8261")
	)
	(text "I2C PULL-UPS  -  bus A + bus B at 4.7k, the two AS5600 channels at 2.2k"
		(exclude_from_sim no)
		(at 172.72 330.2 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "9ecf2448-a583-571c-bc36-ec1c03c3e9e6")
	)
	(text "The stepsticks carry their own VM bulk, but supply-lead inductance is what kills drivers -"
		(exclude_from_sim no)
		(at 40.64 391.16 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a08b94a8-08fb-5eb0-80a2-33777a162438")
	)
	(text "PWR_FLAGs - all four rails arrive on connectors, nothing on this board drives them"
		(exclude_from_sim no)
		(at 248.92 366.71 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
